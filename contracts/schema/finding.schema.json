{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harting.local/nxdrp/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "required": [
    "finding_id",
    "check_item_id",
    "severity"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "check_item_id": {
      "type": "string"
    },
    "check_item_name": {
      "type": "string"
    },
    "process_type": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "part_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      }
    },
    "measured_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "threshold_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "deviation": {
      "type": [
        "number",
        "null"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "suggestion": {
      "type": "object"
    },
    "detector": {
      "type": "object"
    },
    "message": {
      "type": "string"
    }
  }
}